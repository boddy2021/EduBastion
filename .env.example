# Copy to .env and fill in real values. .env is gitignored — never commit it.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/edubastion

# JWT signing key.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY

# Session lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Master switch for AI text detection. Set to false to skip it entirely, e.g.
# during development or on machines that cannot spare ~2.5 GB of models.
AI_DETECTOR_ENABLED=true

# Load the models at startup rather than on the first submission, so that no
# student waits on a model download in the middle of an exam.
AI_DETECTOR_PRELOAD=true

# Binoculars model pair. Both models must share a tokenizer: a base model and
# its instruct-tuned sibling. Downloaded from Hugging Face on first use (~2.5 GB).
AI_DETECTOR_OBSERVER_MODEL=Qwen/Qwen3-0.6B-Base
AI_DETECTOR_PERFORMER_MODEL=Qwen/Qwen3-0.6B

# Text scoring below this ratio is flagged as machine-generated.
# Model-pair specific — establish it with scripts/calibrate_detector.py.
# Do not copy the value from the paper; it was measured on a different pair.
AI_DETECTOR_BINOCULARS_THRESHOLD=0.9015

# Answers shorter than this are not scored at all — short text carries too
# little signal, and guessing on it produces false accusations.
AI_DETECTOR_MIN_TEXT_LENGTH=60
AI_DETECTOR_MAX_TOKENS=512
